# TenXPros local development environment.

# Database
DATABASE_URL=postgresql://tenxpros:tenxpros_dev@localhost:5433/tenxpros

# Auth
AUTH_SECRET=please-generate-a-real-secret-at-least-32-characters
NEXTAUTH_SECRET=please-generate-a-real-secret-at-least-32-characters
SESSION_SECRET=please-generate-a-real-secret-at-least-32-characters
# Required for local Auth.js development and Docker acceptance.
# Use localhost:3000 for `pnpm dev`; use localhost:3003 in the root Docker env.
# Production must use real AUTH_URL/NEXTAUTH_URL/APP_URL values for the deployed domain.
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Email
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="TenXPros <hello@tenxpros.com>"
ADMIN_EMAIL=admin@tenxpros.test
ADMIN_PASSWORD=ChangeMe123!

# Manual payment links
STRIPE_PAYMENT_LINK_FOUNDING=
STRIPE_PAYMENT_LINK_EARLY=
STRIPE_PAYMENT_LINK_LATE=
STRIPE_PAYMENT_LINK_FINAL=
STRIPE_PAYMENT_LINK_STANDARD=

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional uploads and analytics
UPLOAD_PROVIDER=local
POSTHOG_KEY=

# Secret for the scheduled payment-reminder endpoint (POST /api/cron/payment-reminders)
CRON_SECRET=generate-a-random-secret-at-least-32-characters
