# TenXPros local development environment
# Copy this to .env and tweak values as needed.

# Postgres (matches docker-compose.yml at the repo root).
# Inside the compose network use db:5432 instead.
DATABASE_URL=postgresql://tenxpros:tenxpros_dev@localhost:5433/tenxpros

# 32+ char secret used to sign session cookies. REQUIRED in production.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=please-generate-a-real-secret-at-least-32-characters

# Public app URL used in transactional links and certificate verification URLs.
# In production this MUST be the public domain (e.g. https://tenxpros.com).
APP_URL=http://localhost:3000

# AI providers (optional). The platform falls back to a deterministic mock provider.
AI_ENABLED=false
AI_PROVIDER=mock
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_API_KEY=

# Default region for compliance / data residency notes.
DEFAULT_REGION=eu-west

# --- Demo / admin policy ---
# When true, the seed creates four well-known demo users with documented
# passwords (admin@tenxpros.test, reviewer@tenxpros.test,
# demo.pro@tenxpros.test, demo.org@tenxpros.test). NEVER set this true on
# a public production domain.
ALLOW_DEMO_USERS=true

# Production admin (used by the seed even when ALLOW_DEMO_USERS=false).
# Leave empty in dev unless you want a non-demo admin alongside the demo set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
