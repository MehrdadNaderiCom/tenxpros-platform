generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

// ============================================================

// USER & AUTH

// ============================================================

model User {
  id String @id @default(cuid())

  email String @unique

  emailVerified DateTime?

  name String?

  image String?

  role UserRole @default(APPLICANT)

  passwordHash String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  application Application?

  participantProfile ParticipantProfile?

  tickets Ticket[]

  ticketMessages TicketMessage[]

  directoryProfile DirectoryProfile?

  sessions Session[]

  accounts Account[]

  // Coach relation (self-referential via ParticipantProfile)

  coachedParticipants ParticipantProfile[] @relation("CoachParticipants")

  // Engagement & system relations

  notifications Notification[]

  earnedBadges ParticipantBadge[]

  auditEntries AuditLog[] @relation("AuditActor")

  // Partner Program: a User may be linked to exactly one Partner record.
  partner Partner?
}

enum UserRole {
  APPLICANT

  PARTICIPANT

  COACH

  ADMIN

  // Partner Program: an approved partner with a Partner Panel login.
  PARTNER
}

model Account {
  id String @id @default(cuid())

  userId String

  type String

  provider String

  providerAccountId String

  refresh_token String? @db.Text

  access_token String? @db.Text

  expires_at Int?

  token_type String?

  scope String?

  id_token String? @db.Text

  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Required by NextAuth Prisma Adapter for email verification and password reset

model VerificationToken {
  identifier String

  token String @unique

  expires DateTime

  @@unique([identifier, token])
}

// ============================================================

// APPLICATION

// ============================================================

model Application {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  fullName String

  email String

  country String

  professionalRole String

  domain String

  phone String?

  linkedinUrl String?

  aiExperience AIExperienceLevel

  whyTenXPros String @db.Text

  realProblemBrief String @db.Text

  dataSensitivity DataSensitivity

  timeAvailability TimeAvailability

  preferredLanguage String @default("English")

  consentConfidentiality Boolean @default(false)

  consentTerms Boolean @default(false)

  status ApplicationStatus @default(SUBMITTED)

  adminNotes String? @db.Text

  reviewedAt DateTime?

  reviewedBy String?

  pricingTierAtApply String? // snapshot

  // Marketing attribution (captured at submission)

  utmSource String?

  utmMedium String?

  utmCampaign String?

  utmTerm String?

  utmContent String?

  referrerUrl String?

  landingPage String?

  // Back relation to payments

  payments PaymentRecord[]

  resume ApplicationResume?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// Uploaded resume PDF, stored as bytes in its own table so list queries never
// load file contents. Cascade-deleted with the application.
model ApplicationResume {
  id String @id @default(cuid())

  applicationId String @unique

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  filename String

  mimeType String

  size Int

  data Bytes

  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  SUBMITTED

  UNDER_REVIEW

  ACCEPTED

  REVISE_AND_REAPPLY

  NOT_ACCEPTED

  ENROLLED
}

enum AIExperienceLevel {
  BEGINNER

  INTERMEDIATE

  ADVANCED
}

enum DataSensitivity {
  LOW

  MODERATE

  HIGH

  CRITICAL
}

enum TimeAvailability {
  HOURS_5

  HOURS_8

  HOURS_12_PLUS
}

// ============================================================

// PARTICIPANT PROFILE

// ============================================================

model ParticipantProfile {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  tier CharterTier

  cohortNumber Int?

  enrolledAt DateTime @default(now())

  startsAt DateTime

  expectedEndAt DateTime

  assignedCoachId String?

  assignedCoach User? @relation("CoachParticipants", fields: [assignedCoachId], references: [id])

  coachAssignedAt DateTime?

  // Onboarding progress tracking

  starterPackCompletedAt DateTime?

  status ParticipantStatus @default(ONBOARDING)

  diagnostic DiagnosticIntake?

  path ProgramPath?

  dossier Dossier?

  certification CertificationReview?

  participantModules ParticipantModule[]

  // Back relation to payments

  payments PaymentRecord[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum CharterTier {
  FOUNDING

  EARLY

  LATE

  FINAL

  STANDARD
}

enum ParticipantStatus {
  ONBOARDING

  DIAGNOSTIC_PENDING

  ACTIVE

  CAPSTONE

  UNDER_REVIEW

  CERTIFIED

  CONDITIONALLY_CERTIFIED

  COMPLETED_NOT_CERTIFIED

  NOT_COMPLETED

  PAUSED

  WITHDRAWN
}

// ============================================================

// DIAGNOSTIC INTAKE

// ============================================================

// All fields are nullable to support multi-step draft save.

// Final validation (all fields required) is enforced at submission time

// via Zod schema in lib/validations/diagnostic.ts, not at the database level.

model DiagnosticIntake {
  id String @id @default(cuid())

  participantId String @unique

  participant ParticipantProfile @relation(fields: [participantId], references: [id])

  // 8 customization dimensions (nullable for draft save)

  riskProfile DataSensitivity?

  domainRecognition String?

  solutionPatternHint String?

  aiLiteracyLevel AIExperienceLevel?

  stakeholderComplexity StakeholderComplexity?

  industryRegulatoryWeight RegulatoryWeight?

  timeAvailability TimeAvailability?

  outputType OutputType?

  // detailed responses (nullable for draft save)

  problemContext String? @db.Text

  problemClarity String? @db.Text

  successCriteria String? @db.Text

  organizationalContext String? @db.Text

  goals String? @db.Text

  supportNeeds String? @db.Text

  // draft progress tracking

  currentStep Int @default(1)

  isComplete Boolean @default(false)

  submittedAt DateTime?

  reviewedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum StakeholderComplexity {
  SOLO

  SMALL_TEAM

  DEPARTMENT

  MULTI_STAKEHOLDER
}

enum RegulatoryWeight {
  LIGHT

  MODERATE

  HEAVY
}

enum OutputType {
  INTERNAL

  CLIENT_FACING

  PUBLIC_FACING

  REGULATED
}

// ============================================================

// PROGRAM PATH

// ============================================================

model ProgramPath {
  id String @id @default(cuid())

  participantId String @unique

  participant ParticipantProfile @relation(fields: [participantId], references: [id])

  customizationNotes String? @db.Text

  generatedAt DateTime?

  approvedByAdmin Boolean @default(false)

  approvedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ============================================================

// MODULES (library)

// ============================================================

model Module {
  id String @id @default(cuid())

  number Int // 1-11 (not unique alone, see @@unique below)

  phase ProgramPhase

  title String

  coreQuestion String @db.Text

  description String @db.Text

  learningObjectives Json

  contentMaterials Json

  exercises Json

  artifactTemplate String @db.Text

  passCriteria String @db.Text

  badgeName String

  estimatedHours Float

  // Version control: participants are locked to the version they started with

  // (snapshot in ParticipantModule.moduleVersion). isActive controls whether new

  // participants get this version when their path is generated.

  version Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  participantModules ParticipantModule[]

  @@unique([number, version])
}

enum ProgramPhase {
  FRAME

  DESIGN

  PROVE

  FORESEE
}

model ParticipantModule {
  id String @id @default(cuid())

  participantId String

  participant ParticipantProfile @relation(fields: [participantId], references: [id])

  moduleId String

  module Module @relation(fields: [moduleId], references: [id])

  status ModuleStatus @default(LOCKED)

  unlockedAt DateTime?

  startedAt DateTime?

  submittedAt DateTime?

  passedAt DateTime?

  artifactContent String? @db.Text

  artifactUrl String?

  coachFeedback String? @db.Text

  feedbackAt DateTime?

  feedbackBy String?

  revisionCount Int @default(0)

  badgeEarned Boolean @default(false)

  // Path Builder personalization (set by admin during path approval)

  customizationNotes String? @db.Text

  emphasisLevel ModuleEmphasis @default(STANDARD)

  additionalReadings Json? // structured list of {title, url, note}

  // Module version snapshot (locks participant to the module version they started with)

  moduleVersion Int @default(1)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([participantId, moduleId])
}

enum ModuleStatus {
  LOCKED

  UNLOCKED

  IN_PROGRESS

  SUBMITTED

  PASSED

  REVISE

  REMEDIAL

  HOLD
}

enum ModuleEmphasis {
  LIGHT

  STANDARD

  EXTENDED
}

// ============================================================

// DOSSIER

// ============================================================

model Dossier {
  id String @id @default(cuid())

  participantId String @unique

  participant ParticipantProfile @relation(fields: [participantId], references: [id])

  title String?

  summary String? @db.Text

  finalizedAt DateTime?

  sections DossierSection[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model DossierSection {
  id String @id @default(cuid())

  dossierId String

  dossier Dossier @relation(fields: [dossierId], references: [id])

  sectionType DossierSectionType

  order Int

  content String @db.Text

  status DossierSectionStatus @default(DRAFT)

  lastEditedAt DateTime?

  reviewedAt DateTime?

  feedback Feedback[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([dossierId, sectionType])
}

enum DossierSectionType {
  PROFESSIONAL_CONTEXT

  PROBLEM_DEFINITION

  AI_SUITABILITY

  CONTEXT_STAKEHOLDER_FORESIGHT

  DATA_EVIDENCE

  WORKFLOW_BEFORE_AFTER

  RISK_ETHICS_PRIVACY

  RESPONSIBLE_SOLUTION_DESIGN

  ADOPTION_COMMUNICATION

  VALUE_ROADMAP_PROOF

  PERSONAL_FORESIGHT_PLAN

  FINAL_RECOMMENDATION
}

enum DossierSectionStatus {
  DRAFT

  SUBMITTED

  REVIEWED

  REVISED

  APPROVED
}

// ============================================================

// TICKETS

// ============================================================

model Ticket {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id])

  subject String

  category TicketCategory

  status TicketStatus @default(OPEN)

  priority TicketPriority @default(NORMAL)

  assignedToId String?

  closedAt DateTime?

  messages TicketMessage[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum TicketCategory {
  MODULE_QUESTION

  DOSSIER_HELP

  AI_SUITABILITY

  EVIDENCE

  WORKFLOW

  FORESIGHT

  CAPSTONE

  TECHNICAL

  OTHER
}

enum TicketStatus {
  OPEN

  WAITING_RESPONSE

  AWAITING_PARTICIPANT

  RESOLVED

  CLOSED
}

enum TicketPriority {
  LOW

  NORMAL

  HIGH
}

model TicketMessage {
  id String @id @default(cuid())

  ticketId String

  ticket Ticket @relation(fields: [ticketId], references: [id])

  userId String

  user User @relation(fields: [userId], references: [id])

  body String @db.Text

  attachmentUrl String?

  createdAt DateTime @default(now())
}

// ============================================================

// FEEDBACK (section-level at launch; inline annotation is a post-launch enhancement)

// ============================================================

model Feedback {
  id String @id @default(cuid())

  dossierSectionId String?

  dossierSection DossierSection? @relation(fields: [dossierSectionId], references: [id])

  type FeedbackType

  content String @db.Text

  authorId String

  authorName String

  createdAt DateTime @default(now())
}

enum FeedbackType {
  MILESTONE

  GENERAL

  REVISION_REQUEST

  APPROVAL
}

// ============================================================

// CERTIFICATION

// ============================================================

model CertificationReview {
  id String @id @default(cuid())

  participantId String @unique

  participant ParticipantProfile @relation(fields: [participantId], references: [id])

  outcome CertificationOutcome

  rubricScores Json

  reviewerNotes String @db.Text

  reviewedBy String

  reviewedAt DateTime @default(now())

  badgeIssuedAt DateTime?

  certificateUrl String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum CertificationOutcome {
  CERTIFIED

  CONDITIONALLY_CERTIFIED

  COMPLETED_NOT_CERTIFIED

  NOT_COMPLETED
}

// ============================================================

// DIRECTORY

// ============================================================

model DirectoryProfile {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  slug String @unique

  displayName String

  title String

  domain String

  bio String @db.Text

  photoUrl String?

  location String?

  languages String[]

  availability AvailabilityStatus @default(NOT_AVAILABLE)

  availableFor String[]

  linkedinUrl String?

  websiteUrl String?

  contactEmail String?

  isPublic Boolean @default(false)

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum AvailabilityStatus {
  AVAILABLE

  LIMITED

  NOT_AVAILABLE
}

// ============================================================

// PRICING & PAYMENT

// ============================================================

model PricingTier {
  id String @id @default(cuid())

  name String @unique

  tier CharterTier

  price Int

  membersLimit Int

  membersCount Int @default(0)

  isActive Boolean @default(false)

  openedAt DateTime?

  closedAt DateTime?

  benefits Json

  paymentMethod PaymentMethod?

  paymentCurrency String?

  paymentLink String?

  paymentInstructions String?

  paymentDueDays Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model PaymentRecord {
  id String @id @default(cuid())

  applicationId String?

  application Application? @relation(fields: [applicationId], references: [id])

  participantId String?

  participant ParticipantProfile? @relation(fields: [participantId], references: [id])

  amount Int

  currency String @default("USD")

  stripeSessionId String? @unique

  stripeChargeId String? @unique

  status PaymentStatus

  paidAt DateTime?

  method PaymentMethod?

  paymentLink String?

  paymentInstructions String?

  dueAt DateTime?

  discountNote String?

  showDiscountNoteToApplicant Boolean @default(false)

  internalNote String?

  instructionsSentAt DateTime?

  reminderSentAt DateTime?

  expiryNoticeSentAt DateTime?

  waivedAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING

  INSTRUCTIONS_SENT

  PAID

  WAIVED

  FAILED

  CANCELLED

  REFUNDED
}

enum PaymentMethod {
  WISE

  STRIPE

  MANUAL_INVOICE

  BANK_TRANSFER

  OTHER
}

// ============================================================

// EMAIL EVENTS

// ============================================================

// Schema present from day one; logging activated in Phase 4.

model EmailEvent {
  id String @id @default(cuid())

  to String

  subject String

  template String

  status String

  error String? @db.Text

  sentAt DateTime?

  createdAt DateTime @default(now())
}

// ============================================================

// ANALYTICS & SITE EVENTS

// ============================================================

// Captures both authenticated and anonymous events for product, marketing, and ops analytics.

// External analytics (PostHog/Plausible) handle page views and high-volume events.

// This model captures business-critical events that admins query directly in the dashboard.

model SiteEvent {
  id String @id @default(cuid())

  userId String? // null for anonymous visitors

  sessionId String?

  eventType String // see enum-like constants in lib/analytics/events.ts

  eventData Json?

  url String?

  referrer String?

  userAgent String?

  ipHash String? // hashed for privacy

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
}

// Standard event type constants (defined in lib/analytics/events.ts):

// PAGE_VIEW, CTA_CLICK_APPLY, CTA_CLICK_PRICING, APPLICATION_STARTED,

// APPLICATION_SUBMITTED, APPLICATION_ACCEPTED, PAYMENT_INITIATED, ENROLLMENT_COMPLETED,

// STARTER_PACK_COMPLETED, DIAGNOSTIC_STARTED, DIAGNOSTIC_SUBMITTED, MODULE_STARTED,

// MODULE_SUBMITTED, MODULE_PASSED, DOSSIER_SECTION_SAVED, DOSSIER_SECTION_SUBMITTED,

// CAPSTONE_SUBMITTED, CERTIFICATION_DECISION, TICKET_CREATED, EMAIL_OPENED, EMAIL_CLICKED.

// ============================================================

// NOTIFICATIONS

// ============================================================

model Notification {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title String

  body String @db.Text

  url String? // deep link into portal/admin

  isRead Boolean @default(false)

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

enum NotificationType {
  MODULE_UNLOCKED

  COACH_FEEDBACK

  REVISION_REQUESTED

  TICKET_RESPONSE

  CERTIFICATION_DECISION

  DOSSIER_REVIEWED

  BADGE_EARNED

  ANNOUNCEMENT

  SYSTEM
}

// ============================================================

// BADGES & RANKS

// ============================================================

model Badge {
  id String @id @default(cuid())

  slug String @unique // e.g., "tenx-mindset", "rank-ai-ready-professional"

  name String

  description String @db.Text

  category BadgeCategory

  iconUrl String?

  color String? // hex

  order Int @default(0)

  isActive Boolean @default(true)

  participantBadges ParticipantBadge[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum BadgeCategory {
  MODULE // 11 per-module badges (TenX Mindset, AI Core, Frame Badge, etc.)

  RANK // 3 ranks (AI-Ready Professional, AI Problem Solver, Future-Ready)

  CAPSTONE // Capstone Seal

  SPECIAL // Foresight Strategist, Founding Member, future special badges
}

model ParticipantBadge {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String

  badge Badge @relation(fields: [badgeId], references: [id])

  // Public verification: each issued badge has a unique URL at /verify/[verificationCode]

  verificationCode String @unique @default(cuid())

  earnedAt DateTime @default(now())

  isPublic Boolean @default(true)

  // Optional context (which module/path triggered this badge)

  contextType String? // "MODULE", "RANK", "CAPSTONE"

  contextRef String? // module id, rank slug, capstone id

  @@unique([userId, badgeId])
  @@index([verificationCode])
}

// ============================================================

// AUDIT LOG

// ============================================================

// Records every state change and admin action for accountability and forensics.

// Used to populate /admin/audit log view.

model AuditLog {
  id String @id @default(cuid())

  actorId String? // user who performed the action; null for system actions

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  actorRole String? // snapshot of role at time of action

  action String // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, EXPORT, etc.

  entity String // model name (Application, ParticipantProfile, Dossier, etc.)

  entityId String?

  changes Json? // { before: {...}, after: {...} } for updates

  metadata Json? // additional context

  ipHash String?

  userAgent String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ============================================================

// ADMIN SETTINGS

// ============================================================

// Key-value store for site-wide configuration adjustable by admin without code changes.

// Examples: maintenance_mode, application_paused, current_active_tier, brand_logo_url,

// loyalty_discount_percentages, support_response_sla_hours.

model AdminSetting {
  id String @id @default(cuid())

  key String @unique

  value String @db.Text

  category String // GENERAL, EMAIL, PRICING, FEATURE_FLAGS, BRANDING

  label String? // human-readable label for admin UI

  isPublic Boolean @default(false) // can be read by public site (e.g., brand colors)

  updatedAt DateTime @updatedAt

  updatedBy String?
}

// ============================================================

// MARKETING. "TenXPros Command": founder-led sales operating system.
// Super-admin only (SUPER_ADMIN_EMAIL). Campaigns set goals & channel quotas;
// prospects move through an outreach pipeline with a follow-up cadence; daily
// activity is logged against quotas; the playbook holds editable templates.

// ============================================================

model MarketingCampaign {
  id String @id @default(cuid())

  name String

  isActive Boolean @default(false)

  startDate DateTime

  endDate DateTime

  // Outcome goals (paid customers): three tiers of success.
  targetBreakEven Int @default(2)

  targetIdeal Int @default(3)

  targetStretch Int @default(5)

  // How many live (not lost/dropped) prospects should be in motion.
  targetPipeline Int @default(30)

  // Coach pivot thresholds.
  pivotMessagesThreshold Int @default(150)

  pivotCallsThreshold Int @default(10)

  // Paid customers won outside the site (counted into goal progress).
  offPlatformPaid Int @default(0)

  notes String? @db.Text

  channels MarketingChannel[]

  prospects Prospect[]

  dailyLogs MarketingDailyLog[]

  coachAdvice MarketingCoachAdvice[]

  aiSuggestions MarketingAiSuggestion[]

  attempts MarketingAttempt[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model MarketingChannel {
  id String @id @default(cuid())

  campaignId String

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  channel String // linkedin, whatsapp, email, instagram, telegram, twitter, phone

  // Daily floor/ceiling and weekly cap (stay under platform ban thresholds).
  dailyMin Int @default(5)

  dailyMax Int @default(15)

  weeklyCap Int @default(70)

  // Content plan: public activity on this channel, separate from outreach.
  postsPerDay Int @default(0)

  engagePerDay Int @default(0)

  // What to publish/do here (free text, e.g. "1 dossier-insight post, comment on 5 ICP posts").
  contentNote String?

  enabled Boolean @default(true)

  @@unique([campaignId, channel])
}

enum ProspectStage {
  LIST

  APPROACHED

  REPLIED

  CALL_BOOKED

  CALL_HELD

  APPLIED

  PAID

  LOST

  DROPPED
}

enum ProspectWarmth {
  WARM

  REFERRAL

  COLD_ENGAGED

  COLD
}

enum FollowupStatus {
  ACTIVE

  PARKED

  DROPPED
}

model Prospect {
  id String @id @default(cuid())

  campaignId String

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name String

  // Industry/role context. No confidential details.
  context String?

  warmth ProspectWarmth @default(COLD)

  // 1-5 each; prioritization score = warmthWeight x (pain + authority + icpFit).
  pain Int @default(3)

  authority Int @default(3)

  icpFit Int @default(3)

  stage ProspectStage @default(LIST)

  lostReason String?

  // Contact handles (any subset).
  email String?

  linkedin String?

  whatsapp String?

  phone String?

  telegram String?

  instagram String?

  twitter String?

  // Comma-separated asset keys sent: founder_letter,sample_dossier,review_rubric
  assetsSent String?

  followupStatus FollowupStatus @default(ACTIVE)

  followupStep Int @default(0)

  followupNextDue DateTime?

  followupDropReason String?

  // Set when the prospect's email matches a real Application (live funnel link).
  applicationId String?

  notes String? @db.Text

  touches ProspectTouch[]

  attempts MarketingAttempt[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([campaignId, stage])
}

model ProspectTouch {
  id String @id @default(cuid())

  prospectId String

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type String // message, follow_up, reply, call, asset, note

  channel String?

  summary String?

  at DateTime @default(now())

  @@index([prospectId, at])
}

model MarketingDailyLog {
  id String @id @default(cuid())

  campaignId String

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Calendar date (UTC midnight) the activity belongs to.
  date DateTime

  channel String

  messages Int @default(0)

  replies Int @default(0)

  calls Int @default(0)

  posts Int @default(0)

  engagements Int @default(0)

  notes String?

  @@unique([campaignId, date, channel])
}

// Journal: one row per real-world effort (a message, a follow-up, a post, an
// engagement block, a conversation) with outcome, time spent, and a 1-5
// self-rating. Saving an attempt auto-increments the matching
// MarketingDailyLog counters, so daily stats never need double entry.
model MarketingAttempt {
  id String @id @default(cuid())

  campaignId String

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // outreach, follow_up, reply, conversation, post, engagement, other
  kind String

  // Kind-specific flavor for analysis (see ATTEMPT_VARIANTS in constants):
  // post -> content format (text/image/document/...), outreach -> approach,
  // engagement -> action, reply -> their tone.
  variant String?

  channel String?

  prospectId String?

  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  // What I did and to whom (free text).
  summary String

  // What happened / the result so far.
  outcome String?

  // Time it took, in minutes.
  minutes Int @default(0)

  // 1-5 self-rating of how it went.
  satisfaction Int @default(3)

  // Weak points, lessons, what to try differently next time.
  learnings String?

  at DateTime @default(now())

  updates MarketingAttemptUpdate[]

  @@index([campaignId, at])
}

// Timestamped follow-ups on a journal attempt ("+2h: 14 comments, 3 DMs").
// The original entry stays untouched; the thread documents how the attempt
// played out over time, and the elapsed-since-attempt timing feeds the AI.
model MarketingAttemptUpdate {
  id String @id @default(cuid())

  attemptId String

  attempt MarketingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  note String

  // Kind-specific snapshot numbers (see ATTEMPT_METRICS in constants), e.g.
  // a post's {"impressions":1200,"comments":14}. Only filled fields are kept.
  metrics Json?

  at DateTime @default(now())

  @@index([attemptId, at])
}

model MarketingTemplate {
  id String @id @default(cuid())

  // Stable key for seeded entries (e.g. outreach_warm, objection_price).
  key String @unique

  category String // outreach, follow_up, objection, asset, question, principle

  title String

  body String @db.Text

  sortOrder Int @default(0)

  updatedAt DateTime @updatedAt
}

// Editable playbook sections. Templates reference a category by its key
// (string, no FK) so categories can be renamed freely; deletion is blocked
// while templates still use the key.
model MarketingTemplateCategory {
  id String @id @default(cuid())

  key String @unique

  title String

  note String?

  sortOrder Int @default(0)

  updatedAt DateTime @updatedAt
}

// AI coach advice history (OpenRouter). The API key/model live in AdminSetting
// (keys: openrouter_api_key / openrouter_model), pasted by the super admin,
// never stored in code or env files.
// Per-area AI suggestions (channels / activity / prospects / playbook).
// status "error" rows carry the failure message so it renders inline.
model MarketingAiSuggestion {
  id String @id @default(cuid())

  campaignId String

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  area String

  model String

  status String @default("ok")

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([campaignId, area, createdAt])
}

model MarketingCoachAdvice {
  id String @id @default(cuid())

  campaignId String

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  model String

  advice String @db.Text

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}

// ============================================================
// PARTNER PROGRAM
// ============================================================
// The Partner Panel is the single source of truth: nothing is approved,
// registered, promoted or confirmed except by a Company action recorded here,
// audited via the existing AuditLog (action prefixed PANEL_*). Money fields are
// integer CENTS; rates/caps are integer BASIS POINTS (1% = 100 bp), no floats.
// All commercial numbers resolve through ProgramConfig defaults + optional
// per-partner PartnerConfig overrides (see src/lib/partner/config.ts).

enum PartnerStatus {
  APPLICANT
  PILOT
  TIER1
  TIER2
  TIER3
  INACTIVE
  TERMINATED
}

enum PartnerTier {
  TIER1
  TIER2
  TIER3
}

enum PartnerApplicationStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DealType {
  B2C
  B2B
}

enum OfferingType {
  B2C_CHARTER
  B2B_ENGAGEMENT
  OTHER
}

enum DealProductLine {
  TENXPROS
  TENXOPS
}

enum DealRegStatus {
  SUBMITTED
  CONFIRMED
  DECLINED
  LAPSED
  WITHDRAWN
}

enum PartnerFunction {
  BASIC_INTRO
  QUALIFIED_ORIGINATION
  STRONG_ORIGINATION
  CLOSING
  DELIVERY
  OVERRIDE
  FOCUS_BONUS
  GROWTH_BONUS
}

enum CommissionStatus {
  ACCRUED
  PAYABLE
  PAID
  REVERSED
}

enum SeatStatus {
  PENDING
  PAID_COLLECTED
  REFUNDED
  CANCELLED
}

enum EngagementStatus {
  REQUESTED
  CONFIRMED
  DECLINED
}

enum FocusGrantStatus {
  ACTIVE
  LAPSED
  WITHDRAWN
}

enum ScorecardDay {
  DAY_14
  DAY_30
  DAY_60
  DAY_90
}

enum DeliveryMode {
  FIXED_FEE
  PERCENTAGE
}

enum RefundEventType {
  REFUND
  CHARGEBACK
  CANCELLATION
  CREDIT
  REVERSAL
}

/// A public application to join the Partner Program (pre-approval). Approval
/// creates the Partner record + Panel Confirmation audit entry.
model PartnerApplication {
  id String @id @default(cuid())
  fullName String
  email String
  phone String?
  country String
  region String?
  linkedinUrl String?
  background String @db.Text
  audience String // B2C | B2B | BOTH
  targetMarkets String @db.Text
  accountJustification String @db.Text
  heardFrom String?
  consentNoEquity Boolean @default(false)
  status PartnerApplicationStatus @default(NEW)
  reviewerNotes String? @db.Text
  reviewedAt DateTime?
  reviewedBy String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  referrerUrl String?
  landingPage String?
  ipHash String?
  partner Partner?
  documents PartnerApplicationDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

enum PartnerDocumentKind {
  RESUME
  COVER_LETTER
}

/// Optional resume / cover letter uploaded with a Partner Program application,
/// stored as bytes in its own table so list queries never load file contents.
/// One row per kind per application; cascade-deleted with the application.
model PartnerApplicationDocument {
  id String @id @default(cuid())
  applicationId String
  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind PartnerDocumentKind
  filename String
  mimeType String
  size Int
  data Bytes
  createdAt DateTime @default(now())

  @@unique([applicationId, kind])
}

/// An approved partner. status drives the lifecycle; tier drives economics &
/// limits (pilot runs at TIER1). A User link is created when the partner sets a
/// password to access the Partner Panel.
model Partner {
  id String @id @default(cuid())
  userId String? @unique
  user User? @relation(fields: [userId], references: [id])
  applicationId String? @unique
  application PartnerApplication? @relation(fields: [applicationId], references: [id])

  status PartnerStatus @default(APPLICANT)
  tier PartnerTier @default(TIER1)

  displayName String
  contactEmail String
  country String?

  pilotStartDate DateTime?
  activationGatePassedAt DateTime?
  activeStatus Boolean @default(false)
  lastActivityAt DateTime?
  recognitionTitle String?
  qualityFlagged Boolean @default(false)
  terminatedAt DateTime?
  terminationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config PartnerConfig?
  activationItems ActivationGateItem[]
  scorecard ScorecardCheckpoint[]
  dealRegistrations DealRegistration[]
  registeredAccounts RegisteredAccount[]
  closedDeals ClosedDeal[]
  commissions CommissionEntry[]
  engagements TenXOpsEngagement[]
  focusGrants FocusGrant[]
  qualityFlags QualityFlag[]
  academyProgress AcademyProgress[]
  academyExerciseAttempts AcademyExerciseAttempt[]
  academyExamSittings AcademyExamSitting[]
  academyBadge PartnerAcademyBadge?

  @@index([status])
}

/// Singleton row holding every global program default (basis points / cents).
/// Created by the migration (ON CONFLICT DO NOTHING) and self-healed by the
/// resolver. Edited from /admin/partners/config; every change is audited.
model ProgramConfig {
  id String @id @default("singleton")

  // Commission rates by function (basis points)
  basicIntroductionBp Int @default(500)
  qualifiedOriginationB2cBp Int @default(1000)
  qualifiedOriginationB2bBp Int @default(800)
  strongOriginationB2cBp Int @default(1500)
  strongOriginationB2bBp Int @default(1200)
  strongOriginationUnlockSeats Int @default(40)
  closingB2cBp Int @default(500)
  closingB2bBp Int @default(1000)
  deliveryMode DeliveryMode @default(PERCENTAGE)
  deliveryPercentMinBp Int @default(500)
  deliveryPercentMaxBp Int @default(800)

  // Caps (basis points)
  capB2cBp Int @default(2500)
  capB2bBp Int @default(3000)
  tier3FocusHardCeilingBp Int @default(3500)

  // Origination window & override
  originationWindowMonths Int @default(12)
  overrideShareBp Int @default(5000)
  majorNewEngagementMinSeats Int @default(15)
  trailPeriodMonths Int @default(12)

  // Tier eligibility
  tierQualifyingWindowMonths Int @default(12)
  tier2SeatThreshold Int @default(40)
  tier3FocusSeatThreshold Int @default(15)

  // Tier 3 focus bonus
  focusBonusStartBp Int @default(100)
  focusBonusAnnualIncrementBp Int @default(100)
  focusBonusCeilingBp Int @default(3500)

  // Growth bonus
  growthBonusOrgThreshold Int @default(3)
  growthBonusBp Int @default(100)

  // Pipeline & account limits (per tier)
  maxOpenAccountsTier1 Int @default(3)
  maxOpenAccountsTier2 Int @default(5)
  maxOpenAccountsTier3 Int @default(10)
  pilotFirst30DaysMaxAccountsTier1 Int @default(2)
  pilotFirst30DaysWindowDays Int @default(30)
  pipelineProtectionDaysTier1 Int @default(120)
  pipelineProtectionDaysTier2 Int @default(150)
  pipelineProtectionDaysTier3 Int @default(180)
  quietAccountLapseDaysTier1 Int @default(30)
  quietAccountLapseDaysTier2 Int @default(45)
  quietAccountLapseDaysTier3 Int @default(60)
  firstRightHours Int @default(48)
  dealConfirmationWindowBusinessDays Int @default(5)

  // Active Status
  activeStatusResponseBusinessDays Int @default(5)
  activeStatusCureDaysTier1 Int @default(30)
  activeStatusCureDaysTier2 Int @default(45)
  activeStatusCureDaysTier3 Int @default(60)
  transitionDays Int @default(30)

  // Payment
  currency String @default("USD")
  paymentBusinessDays Int @default(30)
  smallPayoutThresholdCents Int @default(2500)
  smallPayoutCarryForward Boolean @default(true)

  // Clawback
  clawbackDays Int @default(120)

  // Pilot & termination
  pilotDays Int @default(90)
  pilotTerminationNoticeDays Int @default(7)
  postPilotTerminationNoticeDays Int @default(30)
  materialBreachCureDays Int @default(15)
  windDownDays Int @default(30)
  programAmendmentNoticeDays Int @default(30)

  // Post-termination restrictions
  nonCircumventionMonths Int @default(24)
  nonSolicitationMonths Int @default(12)
  lateStageTailDays Int @default(90)

  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Per-partner overrides. Every field is nullable; null falls back to
/// ProgramConfig. resolvePartnerConfig() merges the two.
model PartnerConfig {
  id String @id @default(cuid())
  partnerId String @unique
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  basicIntroductionBp Int?
  qualifiedOriginationB2cBp Int?
  qualifiedOriginationB2bBp Int?
  strongOriginationB2cBp Int?
  strongOriginationB2bBp Int?
  strongOriginationUnlockSeats Int?
  closingB2cBp Int?
  closingB2bBp Int?
  deliveryMode DeliveryMode?
  deliveryPercentMinBp Int?
  deliveryPercentMaxBp Int?

  capB2cBp Int?
  capB2bBp Int?
  tier3FocusHardCeilingBp Int?

  originationWindowMonths Int?
  overrideShareBp Int?
  majorNewEngagementMinSeats Int?
  trailPeriodMonths Int?

  tierQualifyingWindowMonths Int?
  tier2SeatThreshold Int?
  tier3FocusSeatThreshold Int?

  focusBonusStartBp Int?
  focusBonusAnnualIncrementBp Int?
  focusBonusCeilingBp Int?

  growthBonusOrgThreshold Int?
  growthBonusBp Int?

  maxOpenAccountsTier1 Int?
  maxOpenAccountsTier2 Int?
  maxOpenAccountsTier3 Int?
  pilotFirst30DaysMaxAccountsTier1 Int?
  pilotFirst30DaysWindowDays Int?
  pipelineProtectionDaysTier1 Int?
  pipelineProtectionDaysTier2 Int?
  pipelineProtectionDaysTier3 Int?
  quietAccountLapseDaysTier1 Int?
  quietAccountLapseDaysTier2 Int?
  quietAccountLapseDaysTier3 Int?
  firstRightHours Int?
  dealConfirmationWindowBusinessDays Int?

  activeStatusResponseBusinessDays Int?
  activeStatusCureDaysTier1 Int?
  activeStatusCureDaysTier2 Int?
  activeStatusCureDaysTier3 Int?
  transitionDays Int?

  currency String?
  paymentBusinessDays Int?
  smallPayoutThresholdCents Int?
  smallPayoutCarryForward Boolean?

  clawbackDays Int?

  pilotDays Int?
  pilotTerminationNoticeDays Int?
  postPilotTerminationNoticeDays Int?
  materialBreachCureDays Int?
  windDownDays Int?
  programAmendmentNoticeDays Int?

  nonCircumventionMonths Int?
  nonSolicitationMonths Int?
  lateStageTailDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Activation Gate checklist item (onboarding, approved messaging, no-equity
/// acknowledgement, target list). Gate passes when all required items complete.
model ActivationGateItem {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  key String
  label String
  completed Boolean @default(false)
  completedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([partnerId, key])
}

/// 90-day pilot scorecard checkpoint (Schedule H).
model ScorecardCheckpoint {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  day ScorecardDay
  requiredEvidence String @db.Text
  met Boolean @default(false)
  reviewedAt DateTime?
  reviewerNote String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, day])
}

/// A deal/account registration (Schedule B / Attachment 1). Effective only on
/// Panel Confirmation. The same form opens a TenXOps engagement case (clause 10A).
model DealRegistration {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  productLine DealProductLine @default(TENXPROS)
  offering OfferingType @default(B2B_ENGAGEMENT)
  legalEntity String
  country String
  businessUnit String?
  contactName String?
  contactTitle String?
  estSeats Int?
  estValueCents Int?
  functionsIntended String[] // origination / closing / delivery
  justification String @db.Text
  widerScopeRequested String?

  status DealRegStatus @default(SUBMITTED)
  confirmedScope String?
  firstRightExpiresAt DateTime?
  pipelineProtectionExpiresAt DateTime?
  confirmedByUserId String?
  declineReason String?
  submittedAt DateTime @default(now())
  decidedAt DateTime?

  registeredAccount RegisteredAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
  @@index([status, submittedAt])
}

/// A confirmed registration becomes a Registered Account, scoped per clause 7.
model RegisteredAccount {
  id String @id @default(cuid())
  dealRegistrationId String @unique
  dealRegistration DealRegistration @relation(fields: [dealRegistrationId], references: [id], onDelete: Cascade)
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  legalEntity String
  country String
  businessUnit String?
  offering OfferingType
  scope String
  isHouseAccount Boolean @default(false)
  isDirectRegistration Boolean @default(false)
  managed Boolean @default(true)
  protectionExpiresAt DateTime?
  lastMeaningfulUpdateAt DateTime?
  lapsedAt DateTime?

  closedDeals ClosedDeal[]
  engagements TenXOpsEngagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

/// Entities off-limits to registration (Schedule A13). A confidential list.
model HouseAccount {
  id String @id @default(cuid())
  entityName String
  domain String?
  note String?
  createdByUserId String?
  createdAt DateTime @default(now())

  @@index([entityName])
}

/// A binding agreement with cleared payment (in whole or part). Commission base.
model ClosedDeal {
  id String @id @default(cuid())
  partnerId String
  // Restrict: a partner with recorded financial history can never be hard-deleted.
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  registeredAccountId String?
  registeredAccount RegisteredAccount? @relation(fields: [registeredAccountId], references: [id])

  dealType DealType
  productLine DealProductLine @default(TENXPROS)
  netReceiptsCents Int
  currency String @default("USD")
  deliveredAt DateTime?
  paymentClearedAt DateTime?
  signedAt DateTime?
  originationRateBpAtOpen Int?
  originationWindowStart DateTime?
  trailPeriodEnd DateTime?
  isMajorNewEngagement Boolean @default(false)
  conversionRate Float?
  conversionDate DateTime?
  industryOrRegion String?

  seats SeatRecord[]
  commissions CommissionEntry[]
  refundEvents RefundEvent[]
  qualityFlags QualityFlag[]
  tenXOpsEngagement TenXOpsEngagement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

/// A group of seats on a closed deal. Only PAID_COLLECTED (and not quality-
/// disregarded) seats count toward any target, tier or bonus.
model SeatRecord {
  id String @id @default(cuid())
  closedDealId String
  closedDeal ClosedDeal @relation(fields: [closedDealId], references: [id], onDelete: Cascade)
  count Int @default(1)
  status SeatStatus @default(PENDING)
  industryOrRegion String?
  sourcedByPartner Boolean @default(true)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([closedDealId])
  @@index([status])
}

/// A computed commission line for one function on one closed deal.
model CommissionEntry {
  id String @id @default(cuid())
  partnerId String
  // Restrict: commission history is never lost via a partner hard-delete.
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  closedDealId String
  closedDeal ClosedDeal @relation(fields: [closedDealId], references: [id], onDelete: Cascade)

  function PartnerFunction
  rateBp Int
  baseAmountCents Int
  amountCents Int
  // Idempotent partial/cumulative refund reversal: net payable = amountCents - reversedCents.
  reversedCents Int @default(0)
  // A fixed-fee line keeps its exact amount through recompute (not re-derived from rateBp).
  isFlat Boolean @default(false)
  status CommissionStatus @default(ACCRUED)
  payableOn DateTime?
  paidOn DateTime?
  currency String @default("USD")
  conversionRate Float?
  conversionDate DateTime?
  queryFlag Boolean @default(false)
  queryNote String?
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
  @@index([closedDealId])
}

/// A coaching partner may request to open a TenXOps engagement on an account
/// (clause 10A). On confirmation it becomes a B2B ClosedDeal; its seats are NOT
/// counted toward partner targets/tiers.
model TenXOpsEngagement {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  registeredAccountId String?
  registeredAccount RegisteredAccount? @relation(fields: [registeredAccountId], references: [id])
  closedDealId String? @unique
  closedDeal ClosedDeal? @relation(fields: [closedDealId], references: [id])

  organisation String
  justification String @db.Text
  status EngagementStatus @default(REQUESTED)
  confirmedByUserId String?
  decidedAt DateTime?
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
}

/// A Tier 3 industry/region focus (Schedule C). Time-limited, re-earned yearly.
model FocusGrant {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  industryOrRegion String
  grantedAt DateTime @default(now())
  expiresAt DateTime
  continuouslyHeldSince DateTime @default(now())
  currentBonusBp Int @default(100)
  status FocusGrantStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
}

/// A refund / chargeback / cancellation that reverses commission (clause 15).
model RefundEvent {
  id String @id @default(cuid())
  closedDealId String
  closedDeal ClosedDeal @relation(fields: [closedDealId], references: [id], onDelete: Cascade)
  type RefundEventType
  amountCents Int
  occurredAt DateTime @default(now())
  withinWindow Boolean @default(true)
  reversedCommissionCents Int @default(0)
  note String?
  createdAt DateTime @default(now())

  @@index([closedDealId])
}

/// A quality/compliance flag; disregardForTargets removes affected sales from
/// targets and bonuses (Schedule H4).
model QualityFlag {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  closedDealId String?
  closedDeal ClosedDeal? @relation(fields: [closedDealId], references: [id])
  reason String @db.Text
  disregardForTargets Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// ===========================================================================
// Partner Academy
// ===========================================================================

enum AcademyQuestionPool {
  EXERCISE
  EXAM
}

/// A training module in the Partner Academy. Ordered 1..N; passing one unlocks
/// the next. passMark / examSize / examCooldownHours default to the spec values
/// and are editable per module.
model AcademyModule {
  id String @id @default(cuid())
  slug String @unique
  order Int
  title String
  summary String
  passMark Int @default(80)
  examSize Int @default(10)
  examCooldownHours Int @default(24)
  isPublished Boolean @default(true)
  lessons AcademyLesson[]
  questions AcademyQuestion[]
  progress AcademyProgress[]
  examSittings AcademyExamSitting[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model AcademyLesson {
  id String @id @default(cuid())
  moduleId String
  module AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order Int
  title String
  body String @db.Text
  audioText String @db.Text

  @@index([moduleId, order])
}

/// One multiple-choice question. A question never appears in both pools of a
/// module, and no stem repeats across modules (enforced by the seed).
model AcademyQuestion {
  id String @id @default(cuid())
  moduleId String
  module AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  pool AcademyQuestionPool
  order Int
  stem String @db.Text
  options Json
  correctIndex Int
  explanation String @db.Text
  exerciseAttempts AcademyExerciseAttempt[]

  @@index([moduleId, pool])
}

/// Per-partner, per-module progress and gating state.
model AcademyProgress {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  moduleId String
  module AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status String @default("locked")
  lessonReadAt DateTime?
  exercisesDone Boolean @default(false)
  examPassed Boolean @default(false)
  bestExamScore Int @default(0)
  examAttempts Int @default(0)
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt

  @@unique([partnerId, moduleId])
  @@index([partnerId])
}

model AcademyExerciseAttempt {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  questionId String
  question AcademyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptNo Int
  selected Int
  correct Boolean
  createdAt DateTime @default(now())

  @@index([partnerId, questionId])
}

model AcademyExamSitting {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  moduleId String
  module AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionIds Json
  answers Json
  score Int
  passed Boolean
  startedAt DateTime @default(now())
  submittedAt DateTime?

  @@index([partnerId, moduleId])
}

model PartnerAcademyBadge {
  id String @id @default(cuid())
  partnerId String @unique
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())
  serial String @unique
  year Int
}

// ===========================================================================
// Annual terms versions (drives the versioned terms page)
// ===========================================================================

model TermsVersion {
  id String @id @default(cuid())
  year Int
  audience String @default("all")
  effectiveFrom DateTime
  effectiveTo DateTime
  bodyHtml String @db.Text
  changelog String @db.Text
  isCurrent Boolean @default(false)
  publishedAt DateTime @default(now())

  @@unique([year, audience])
  @@index([audience, isCurrent])
}

// ===========================================================================
// Newsletter
// ===========================================================================

model NewsletterSubscriber {
  id String @id @default(cuid())
  email String @unique
  status String @default("subscribed")
  source String @default("homepage")
  consentAt DateTime @default(now())
  unsubscribedAt DateTime?
  unsubToken String @unique
  groups NewsletterGroupOnSubscriber[]
  deliveries NewsletterDelivery[]
  createdAt DateTime @default(now())

  @@index([status])
}

model NewsletterGroup {
  id String @id @default(cuid())
  name String @unique
  description String?
  subscribers NewsletterGroupOnSubscriber[]
  createdAt DateTime @default(now())
}

model NewsletterGroupOnSubscriber {
  subscriberId String
  groupId String
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  group NewsletterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([subscriberId, groupId])
}

model NewsletterCampaign {
  id String @id @default(cuid())
  subject String
  bodyHtml String @db.Text
  status String @default("draft")
  targetGroupIds Json
  targetSubscriberIds Json
  sentCount Int @default(0)
  recipientCount Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  sentAt DateTime?
  deliveries NewsletterDelivery[]

  @@index([status])
}

model NewsletterDelivery {
  id String @id @default(cuid())
  campaignId String
  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String?
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  email String
  status String @default("sent")
  error String?
  sentAt DateTime?
  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([email])
}
