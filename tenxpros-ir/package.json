{
  "name": "tenxpros-ir",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Persian RTL edition of TenXPros for tenxpros.ir",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "pnpm lint:content && prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "lint": "eslint . --max-warnings=0",
    "lint:content": "node scripts/lint-content.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:check": "tsx scripts/check-env.ts",
    "env:check:seed": "tsx scripts/check-env.ts --seed",
    "maintenance:cleanup": "tsx scripts/cleanup-data.ts",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "prisma": "^5.22.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.8": "5.0.8",
      "postcss@<8.5.24": "8.5.24",
      "sharp@<0.35.0": "0.35.0"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.8": "patches/brace-expansion@5.0.8.patch"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
