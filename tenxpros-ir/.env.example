# Application
NODE_ENV=production
APP_URL=https://tenxpros.ir
DATABASE_URL=postgresql://tenxpros_ir:replace-with-a-long-password@db:5432/tenxpros_ir?schema=public
ADMIN_SESSION_HOURS=12
APPLICANT_SESSION_DAYS=30
RATE_LIMIT_SALT=replace-with-a-long-random-value
RUN_MIGRATIONS=true

# Public legal identity
# Set these values to the exact contracting entity before accepting payment.
PUBLIC_LEGAL_OPERATOR_NAME=
PUBLIC_LEGAL_OPERATOR_REGISTRATION=
PUBLIC_LEGAL_OPERATOR_ADDRESS=
PUBLIC_LEGAL_JURISDICTION=
PUBLIC_DATA_CONTROLLER_NAME=
PUBLIC_LEGAL_CONTACT_EMAIL=support@tenxpros.ir
PARTNER_APPLICATION_EMAIL=hello@tenxpros.ir

# Initial administrator, used by pnpm db:seed
ADMIN_NAME="مهرداد نادری"
ADMIN_EMAIL=admin@tenxpros.ir
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-long-password

# Secure receipt storage
UPLOAD_DIR=/app/uploads
MAX_RECEIPT_UPLOAD_BYTES=8388608

# Bank transfer details
BANK_ACCOUNT_HOLDER="مهرداد نادری"
BANK_NAME="بانک سامان"
BANK_CARD_NUMBER=6219861043222503
BANK_IBAN=IR350560085980002210941001
BANK_ACCOUNT_NUMBER=859-800-2210941-1
FOUNDING_STANDARD_PRICE_TOMAN=90000000
FOUNDING_CHARTER_PRICE_TOMAN=60000000

# Email
EMAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM="TenXPros Iran <hello@tenxpros.ir>"

# Zoom Server-to-Server OAuth
ZOOM_MODE=zoom
ZOOM_ACCOUNT_ID=replace-me
ZOOM_CLIENT_ID=replace-me
ZOOM_CLIENT_SECRET=replace-me
ZOOM_USER_ID=host@your-domain.com

# Development only
# EMAIL_MODE=log
# ZOOM_MODE=mock
